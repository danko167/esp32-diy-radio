; Copy to private/secrets.ini (git ignores everything in private/) and fill
; in. Like a .env file: these values are compiled into the firmware but never
; committed.

[secrets]
; Password for flashing over Wi-Fi (pio run -e radio-ota -t upload).
; Leave empty to disable over-the-air updates.
ota_password =

; Optional: network to join when the radio has none saved, e.g. after
; erasing the flash. Normally you pick Wi-Fi in Settings on the device.
wifi_ssid =
wifi_password =
